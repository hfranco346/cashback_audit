# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=3000

# --- Database (docker compose exposes Postgres on host port 5433) ----------
DATABASE_URL=postgresql://cashback:cashback@localhost:5433/cashback_audit?schema=public
# Used only by `pnpm test:e2e` (separate database, created by docker compose)
TEST_DATABASE_URL=postgresql://cashback:cashback@localhost:5433/cashback_audit_test?schema=public

# --- Auth: our own JWTs (generate with `openssl rand -base64 48`) -----------
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
# Durations: 15m, 12h, 30d or plain seconds
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Sign in with Google / Apple -------------------------------------------
# Comma separated OAuth client IDs accepted as `aud` (iOS, Android, web)
GOOGLE_CLIENT_IDS=
# Apple identity token audience = the iOS app bundle ID
APPLE_BUNDLE_ID=

# --- Claude (statement extraction + classification) -----------------------
ANTHROPIC_API_KEY=
# Model that reads the statement PDF (needs PDF/vision support).
ANTHROPIC_EXTRACTION_MODEL=claude-sonnet-5-5
# Cheaper/faster model for merchant and category classification (text only).
ANTHROPIC_CLASSIFICATION_MODEL=claude-haiku-5-5
# DEPRECATED: used for extraction only when ANTHROPIC_EXTRACTION_MODEL is unset.
# ANTHROPIC_MODEL=
# Classifier results below this confidence (0-1) are ignored.
CLASSIFICATION_MIN_CONFIDENCE=0.7
# Unconfirmed (AWAITING_RATES) verifications older than this many days are deleted.
AWAITING_RATES_TTL_DAYS=7

# --- RevenueCat -------------------------------------------------------------
# Value of the Authorization header configured on the RevenueCat webhook
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_ENTITLEMENT_ID=pro
# Set to false to disable the paywall check on POST /verifications (local dev)
SUBSCRIPTION_GATE_ENABLED=true

# --- Rate limiting ----------------------------------------------------------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
# Requests per THROTTLE_TTL_SECONDS on POST /verifications (per client)
VERIFICATION_THROTTLE_LIMIT=5
