generator client {
  provider            = "prisma-client"
  output              = "../src/shared/prisma/generated"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  GOOGLE
  APPLE
  EMAIL
}

model User {
  id              String       @id @default(uuid()) @db.Uuid
  provider        AuthProvider
  providerSubject String
  email           String?
  name            String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  refreshTokens RefreshToken[]
  cards         Card[]
  verifications Verification[]
  categories    MerchantCategory[]
  merchants     Merchant[]
  subscriptions Subscription[]
  creditEntries CreditLedger[]
  currencies    UserCurrency[]

  /// UI language preference: AUTO follows the phone.
  locale          UserLocale @default(AUTO)
  /// ISO 4217 code the user reads amounts in; null until chosen.
  primaryCurrency String?    @db.Char(3)

  /// Operator-set (CLI/SQL only): the credits gate never blocks and nothing is consumed or refunded.
  unlimitedCredits Boolean @default(false)

  @@unique([provider, providerSubject])
}

enum UserLocale {
  AUTO
  ES
  EN
}

/// A currency the user works with and the last rate used for it.
model UserCurrency {
  userId            String   @db.Uuid
  code              String   @db.Char(3)
  /// Units of the user's primary currency per 1 unit of `code`; null if unknown.
  lastRateToPrimary Decimal? @db.Decimal(16, 6)
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, code])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  /// All tokens descending from one sign-in share a family (reuse detection).
  familyId  String    @db.Uuid
  /// SHA-256 of the token; the token itself is never stored.
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

enum RewardUnit {
  CASHBACK_CURRENCY
  POINTS
}

/// Never stores a PAN: only the last four digits.
model Card {
  id                    String     @id @default(uuid()) @db.Uuid
  userId                String     @db.Uuid
  alias                 String
  bank                  String
  last4                 String     @db.Char(4)
  network               String?
  rewardUnit            RewardUnit
  /// Points earned per currency unit of reward (used when rewardUnit = POINTS).
  pointsPerCurrencyUnit Decimal    @default(1) @db.Decimal(12, 4)
  baseRatePercent       Decimal    @db.Decimal(7, 4)
  /// Primary currency: rewards, rates and caps are expressed in it.
  currency              String     @db.Char(3)
  /// Loyalty program to audit when a statement lists several.
  rewardProgramName     String?
  /// Currency the reward is paid in when it differs from `currency`; overrides detection.
  rewardCurrency        String?    @db.Char(3)
  /// Where the user sends bank claims (prefilled "To" of the claim email).
  claimEmail            String?
  /// How the bank prints the reward: this month's earnings, an accumulated balance, or decide per statement.
  rewardReporting       RewardReporting @default(AUTO)
  /// Soft delete: a deleted card is hidden but keeps its verification history.
  deletedAt             DateTime?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  rules         CardRule[]
  verifications Verification[]

  @@index([userId])
}

model MerchantCategory {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchants Merchant[]
  rules     CardRule[]

  @@unique([userId, name])
}

model Merchant {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  name       String
  /// Aliases / statement descriptors, e.g. "WAL MART", "WALMART SUC".
  keywords   String[]
  /// The category this merchant is EXPECTED to accrue under.
  categoryId String   @db.Uuid
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category MerchantCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([userId, name])
  @@index([categoryId])
}

model CardRule {
  id          String   @id @default(uuid()) @db.Uuid
  cardId      String   @db.Uuid
  categoryId  String   @db.Uuid
  ratePercent Decimal  @db.Decimal(7, 4)
  /// Max reward (in the card's reward unit) from this rule per statement period.
  monthlyCap  Decimal? @db.Decimal(14, 2)

  card     Card             @relation(fields: [cardId], references: [id], onDelete: Cascade)
  category MerchantCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([cardId, categoryId])
  @@index([categoryId])
}

enum RewardReporting {
  AUTO
  MONTHLY
  CUMULATIVE
}

enum Verdict {
  MATCH
  UNDERPAID
  OVERPAID
}

enum ReportedSource {
  STATEMENT
  OVERRIDE
}

enum VerificationStatus {
  /// Accepted; the statement is being read and classified in the background.
  PROCESSING
  /// Extracted and classified; waiting for the user to confirm the rates.
  AWAITING_RATES
  COMPLETED
  /// Processing ended without a result (see failureCode); the credit is refunded.
  FAILED
}

enum VerificationFailureCode {
  NOT_A_STATEMENT
  EXTRACTION_FAILED
  /// The server restarted while the verification was being processed.
  INTERRUPTED
}

/// Result of auditing one statement. The PDF itself is never stored.
model Verification {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @db.Uuid
  /// Card rows are soft-deleted, so history outlives its card.
  cardId         String         @db.Uuid
  statementBank  String?
  statementLast4 String?
  periodStart    DateTime?      @db.Date
  periodEnd      DateTime?      @db.Date
  /// Currency declared by the statement (may be null).
  currency       String?        @db.Char(3)
  /// Card currency at verification time.
  primaryCurrency String        @db.Char(3)
  totalSpent     Decimal?       @db.Decimal(16, 3)
  totalToPay     Decimal?       @db.Decimal(16, 3)
  status         VerificationStatus @default(COMPLETED)
  failureCode    VerificationFailureCode?
  /// When the user opened a FAILED/COMPLETED result; null = still unseen.
  seenAt         DateTime?
  processingStartedAt DateTime?
  processedAt    DateTime?
  /// Reward figures are null while AWAITING_RATES.
  reportedAmount Decimal?       @db.Decimal(16, 3)
  reportedUnit   RewardUnit
  /// Currency of reported/expected/difference/tolerance (null for points).
  rewardCurrency String?        @db.Char(3)
  reportedLabel  String?
  reportedSource ReportedSource?
  expectedAmount Decimal?       @db.Decimal(16, 3)
  difference     Decimal?       @db.Decimal(16, 3)
  tolerance      Decimal?       @db.Decimal(16, 3)
  verdict        Verdict?
  /// Statement summary per currency column.
  summaries      Json           @default("[]")
  /// Rates used and per-currency subtotals.
  conversion     Json           @default("{}")
  /// Chosen loyalty program and all programs found.
  loyalty        Json           @default("{}")
  /// Rates the statement itself states (as extracted).
  detectedRates  Json           @default("[]")
  /// Rates confirmed by the user and used for the audit.
  appliedRates   Json?
  /// Short narrative of the result; never used in calculations.
  explanation    String?
  /// How the reward figure was derived (monthly vs cumulative) and the balances kept for next month.
  rewardReporting Json?
  breakdown      Json
  transactions   Json
  warnings       Json
  /// Deprecated mirror of models.extraction.
  model          String
  /// Model used per step: { extraction, classification }.
  models         Json           @default("{}")
  createdAt      DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt(sort: Desc)])
  @@index([userId, seenAt])
  @@index([userId, createdAt(sort: Desc)])
  @@index([cardId, createdAt(sort: Desc)])
}

enum SubscriptionStatus {
  ACTIVE
  /// Auto-renew turned off; access continues until expiresAt.
  CANCELLED
  /// Payment failed; access continues until expiresAt (grace period).
  BILLING_ISSUE
  EXPIRED
}

/// One row per (user, entitlement), kept in sync by RevenueCat webhooks.
model Subscription {
  id            String             @id @default(uuid()) @db.Uuid
  userId        String             @db.Uuid
  entitlementId String
  status        SubscriptionStatus
  /// Null for lifetime / non-expiring entitlements.
  expiresAt     DateTime?
  store         String?
  productId     String?
  /// The RevenueCat app user id (must equal our user id).
  rcAppUserId   String
  willRenew     Boolean            @default(true)
  /// Timestamp of the last applied RevenueCat event (orders out-of-order events).
  lastEventAt   DateTime
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entitlementId])
}

/// Processed RevenueCat events; the primary key makes webhook delivery idempotent.
model RevenueCatEvent {
  id         String   @id
  type       String
  userId     String?  @db.Uuid
  outcome    String
  receivedAt DateTime @default(now())
}

enum CreditBucket {
  /// One lifetime credit granted to every new user.
  FREE
  /// Granted each billing period of the subscription; does not roll over.
  PLAN
  /// Bought in consumable packs; never expires.
  PURCHASED
}

enum CreditReason {
  GRANT_FREE
  GRANT_PLAN
  GRANT_PACK
  CONSUME
  REFUND
  EXPIRE_PLAN
}

enum CreditSource {
  APPLE
  GOOGLE
  WEB
  SYSTEM
}

/// Append-only credit ledger; the balance is the sum of the entries per bucket
/// (PLAN entries only count while `periodEnd` is in the future).
model CreditLedger {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @db.Uuid
  delta          Int
  bucket         CreditBucket
  reason         CreditReason
  source         CreditSource
  /// Idempotency key (RevenueCat transaction/event id, `free:<user>`, `refund:<entry>`).
  externalRef    String?      @unique
  /// Verification a CONSUME/REFUND entry belongs to (no FK: history is deletable).
  verificationId String?      @db.Uuid
  /// PLAN entries: end of the billing period they belong to.
  periodEnd      DateTime?
  createdAt      DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, bucket])
}

/// One-time sign-in code sent by email. Only an HMAC of the code is stored.
model EmailLoginCode {
  id         String    @id @default(uuid()) @db.Uuid
  /// Normalized (trimmed, lowercase) address.
  email      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  /// Set when the code was used, replaced by a newer one or burned.
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  /// Requester IP, kept for abuse investigation.
  ip         String?

  @@index([email, createdAt(sort: Desc)])
  @@index([createdAt])
}
