generator client {
  provider            = "prisma-client"
  output              = "../src/shared/prisma/generated"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  GOOGLE
  APPLE
}

model User {
  id              String       @id @default(uuid()) @db.Uuid
  provider        AuthProvider
  providerSubject String
  email           String?
  name            String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  refreshTokens RefreshToken[]
  cards         Card[]
  verifications Verification[]
  categories    MerchantCategory[]
  merchants     Merchant[]

  @@unique([provider, providerSubject])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  /// All tokens descending from one sign-in share a family (reuse detection).
  familyId  String    @db.Uuid
  /// SHA-256 of the token; the token itself is never stored.
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

enum RewardUnit {
  CASHBACK_CURRENCY
  POINTS
}

/// Never stores a PAN: only the last four digits.
model Card {
  id                    String     @id @default(uuid()) @db.Uuid
  userId                String     @db.Uuid
  alias                 String
  bank                  String
  last4                 String     @db.Char(4)
  network               String?
  rewardUnit            RewardUnit
  /// Points earned per currency unit of reward (used when rewardUnit = POINTS).
  pointsPerCurrencyUnit Decimal    @default(1) @db.Decimal(12, 4)
  baseRatePercent       Decimal    @db.Decimal(7, 4)
  currency              String     @db.Char(3)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  rules         CardRule[]
  verifications Verification[]

  @@index([userId])
}

model MerchantCategory {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchants Merchant[]
  rules     CardRule[]

  @@unique([userId, name])
}

model Merchant {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  name       String
  /// Aliases / statement descriptors, e.g. "WAL MART", "WALMART SUC".
  keywords   String[]
  /// The category this merchant is EXPECTED to accrue under.
  categoryId String   @db.Uuid
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category MerchantCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([userId, name])
  @@index([categoryId])
}

model CardRule {
  id          String   @id @default(uuid()) @db.Uuid
  cardId      String   @db.Uuid
  categoryId  String   @db.Uuid
  ratePercent Decimal  @db.Decimal(7, 4)
  /// Max reward (in the card's reward unit) from this rule per statement period.
  monthlyCap  Decimal? @db.Decimal(14, 2)

  card     Card             @relation(fields: [cardId], references: [id], onDelete: Cascade)
  category MerchantCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([cardId, categoryId])
  @@index([categoryId])
}

enum Verdict {
  MATCH
  UNDERPAID
  OVERPAID
}

enum ReportedSource {
  STATEMENT
  OVERRIDE
}

/// Result of auditing one statement. The PDF itself is never stored.
model Verification {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @db.Uuid
  /// History is removed together with its card.
  cardId         String         @db.Uuid
  statementBank  String?
  statementLast4 String?
  periodStart    DateTime?      @db.Date
  periodEnd      DateTime?      @db.Date
  currency       String?        @db.Char(3)
  totalSpent     Decimal?       @db.Decimal(16, 2)
  totalToPay     Decimal?       @db.Decimal(16, 2)
  reportedAmount Decimal        @db.Decimal(16, 2)
  reportedUnit   RewardUnit
  reportedLabel  String?
  reportedSource ReportedSource
  expectedAmount Decimal        @db.Decimal(16, 2)
  difference     Decimal        @db.Decimal(16, 2)
  tolerance      Decimal        @db.Decimal(16, 2)
  verdict        Verdict
  breakdown      Json
  transactions   Json
  warnings       Json
  model          String
  createdAt      DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([cardId, createdAt(sort: Desc)])
}
